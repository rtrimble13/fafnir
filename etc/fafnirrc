# fafnir / duk configuration
# Copy to ~/.fafnirrc (and/or ~/.dukrc) and customize. Format: TOML.
#
# SECRETS: the database password and API keys should come from the environment
# or a secrets manager in preference to this file. Environment variables always
# win over file values:
#   FAFNIR_DSN, FAFNIR_DB_PASSWORD / PGPASSWORD, FMP_API_KEY,
#   FRED_API_KEY, BLS_API_KEY, BEA_API_KEY

[database]
# Either set a full libpq DSN ...
# dsn = "host=localhost port=5432 dbname=fafnir user=fafnir_ingest password=..."
#
# NOTE: a DSN (from `dsn` here or the FAFNIR_DSN env var) is used VERBATIM --
# FAFNIR_DB_PASSWORD is *not* merged into it. With a DSN, pass the password inside it,
# via PGPASSWORD, or via ~/.pgpass. FAFNIR_DB_PASSWORD applies only when the DSN is
# assembled from the host/port/dbname/user parts below.
#
# ... or the individual parts (password preferably via FAFNIR_DB_PASSWORD):
host = "localhost"
port = 5432
dbname = "fafnir"
user = "fafnir_ingest"
# password = ""        # prefer FAFNIR_DB_PASSWORD / PGPASSWORD

[api]
# Financial Modeling Prep (Professional plan). Prefer FMP_API_KEY env var.
fmp_key = ""
# Sharadar's endpoint, shared with duk. Leave unset for the client's default; set
# it (or SHARADAR_BASE_URL) only if `fafnir source probe-sharadar` finds the API
# elsewhere. The Sharadar KEY is not set here: fafnir reads SHARADAR_API_KEY from
# the environment only (see [sharadar] below).
# sharadar_base_url = "https://api.sharadar.com/v1.0/data"
# Fast-follow economic sources:
fred_key = ""
bls_key = ""
bea_key = ""

[general]
# Target universe for the security master.
universe = "us-equity-etf"

# Instrument kinds kept out of the universe (ADR 0012): never minted by
# `fafnir ingest securities`, removed with `fafnir security descope`. Default is all
# three; [] admits them again. Keep one ticker anyway with `fafnir track add`.
# exclude_instruments = ["warrant", "right", "unit"]

# Proactive FMP throttle (Professional plan ~300 req/min; stay just under).
request_rate_per_min = 280

# Re-pull overlap window (days) on incremental price loads, to absorb late
# corrections / re-adjustments.
overlap_days = 5

# The vendor new securities' bars come from: "fmp" until the Sharadar cutover
# (doc/plans/sharadar-adoption.md, P3), then "sharadar". Nothing reads it before.
# primary_price_vendor = "fmp"

# Corporate actions (ADR 0007).
#   actions_mode  : "symbol"   -- one splits + one dividends request per security,
#                                full history each night (the original behaviour);
#                   "calendar" -- one market-wide splits-calendar + dividends-calendar
#                                sweep against a watermark, plus a full pull for any
#                                security that has never had one;
#                   "auto"     -- calendar, and per-symbol for what the calendar
#                                cannot be trusted to cover (funds). Recommended,
#                                once `fafnir source probe-actions` passes on your key.
#   actions_overlap_days      : re-sweep window, to absorb amended dividends.
#   actions_reconcile_buckets : reconcile 1/N of the universe per night against the
#                               per-symbol feed (0 disables). 30 = every security
#                               checked monthly.
actions_mode = "symbol"
actions_overlap_days = 7
actions_reconcile_buckets = 30

# Trading-calendar / partition horizon.
#   calendar_start_year : earliest year to build (set to your backfill start, e.g. 1990).
#   calendar_end_year   : minimum/initial horizon. The nightly `fafnir db ensure-horizon`
#                         (in daily_update.sh) auto-extends partitions + calendar to a
#                         rolling current_year + horizon_extra_years, so you do NOT need
#                         to bump this every year.
#   horizon_extra_years : how far ahead of the current year to stay (default 2).
calendar_start_year = 2015
calendar_end_year = 2027
horizon_extra_years = 2

# Logging.
log_level = "info"
log_dir = "var/fafnir/log"

# --- prices: the restatement guard (doc/ingestion.md) ------------------------
[prices]
# The nightly re-read of the last few sessions never overwrites a stored bar by more
# than these ratios (either direction): it keeps the stored bar and flags
# price_restatement_conflict. An explicit `ingest prices --from` re-fetch overwrites,
# and prints what it restated.
# restatement_max_ratio = 1.25
# restatement_max_volume_ratio = 3

# --- Sharadar (doc/plans/sharadar-adoption.md) ------------------------------
# The key is SHARADAR_API_KEY in the environment (on a host, /etc/fafnir/fafnir.env)
# and never this file: fafnir ignores a key here. [api].sharadar_key is duk's.
# [sharadar]
# Proactive throttle. Sharadar's limit is not yet measured (#49); 429s are retried.
# rate_per_min = 60
# Where bulk export files land, named by content. The default,
# "var/fafnir/landing/sharadar", is relative to the working directory; on a host
# make it absolute.
# bulk_dir = "/var/lib/fafnir/landing/sharadar"

# --- data quality: the dorq engine (doc/dorq.md, ADR 0013) -------------------
[dq]
# Which checks `fafnir dq run` runs: "sql" (default), "dorq" or "both".
# engine = "both"
# dorq_path = "/opt/dorq/bin/dorq"        # or FAFNIR_DORQ_PATH
# dorq_config = "/etc/fafnir/dorq.toml"   # dorq's own settings; empty: its defaults
# dorq's flags go to dorq_shadow_dir instead of the queue until the shadow period
# meets the cutover criteria (doc/dorq.md#the-shadow-period).
# dorq_shadow = true
# The default, "var/dorq-shadow", is relative to the working directory. On a host,
# make it absolute: the systemd units run from /opt/fafnir, the deployed checkout.
# dorq_shadow_dir = "/var/lib/fafnir/dorq-shadow"
# dorq_lookback_sessions = 260
# dorq_threads = 0
# A nightly run also judges the whole history of securities whose history before
# its window is new (minted since the last run) or was rewritten by an operator
# command. Above this many it skips that pass with a warning; use --full.
# dorq_backfill_max = 500

# --- duk (read CLI) settings -------------------------------------------------
# duk reuses [api].fmp_key (-S fmp), [api].sharadar_key (-S sharadar) and
# [database] (-S db). default_source: "db" (the default), "fmp" or "sharadar";
# "live" is accepted as the older name for fmp.
default_source = "db"
default_output_dir = "var/duk"
default_output_type = "csv"
