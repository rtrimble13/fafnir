# fafnir cron schedule (example). Install with: crontab etc/crontab.example
# Adjust paths and times to your host and market timezone. Secrets should be
# sourced from a protected env file rather than inlined here.
#
# Times are server-local. US EOD data is typically settled a few hours after the
# 16:00 ET close; 22:30 ET (here shown as a generic evening slot) is a safe slot.

# Load environment (DSN + API key) from a root-only file. Values must be quoted --
# the recipes below source this file with `set -a; . file`.
# Example fafnir.env contents:
#   FAFNIR_DSN="host=localhost dbname=fafnir user=fafnir_ingest"
#   PGPASSWORD="..."                 # NOT FAFNIR_DB_PASSWORD: that is ignored when
#                                    # FAFNIR_DSN is set (see etc/fafnirrc).
#   FMP_API_KEY="..."
#   FAFNIR_SQL_DIR="/opt/fafnir/sql"
#   PATH="/opt/fafnir/.venv/bin:/usr/local/bin:/usr/bin:/bin"   # if installed in a venv

SHELL=/bin/bash
FAFNIR_HOME=/opt/fafnir

# Daily incremental update (Mon-Fri evening, after settlement), then the
# data-quality sweep over what it loaded -- one entry, so DQ starts when the load
# ends. cron has no ordering: a DQ entry on its own clock started while the load
# was still running (it takes over an hour) and judged a half-loaded night, every
# security not yet loaded looking stale. `;`, not `&&`: as under systemd (the
# fafnir-dq unit is After=, not Requires=, fafnir-daily), DQ still runs after a
# failed load, and then a stale security really is stale. dorq judges a night once,
# so with no new session it writes nothing.
# In Sharadar mode the load includes the fundamentals, from SF1's nightly delta, and
# the factor panel's refresh (#106): no entry of their own. Re-running the
# fundamentals backfill (scripts/backfill_fundamentals.sh) is done by hand, in the
# day, never from here.
30 22 * * 1-5  set -a; . /etc/fafnir/fafnir.env; set +a; cd $FAFNIR_HOME && { scripts/daily_update.sh >> var/fafnir/log/cron_daily.log 2>&1; scripts/run_dq_checks.sh >> var/fafnir/log/cron_dq.log 2>&1; }

# Weekly reconciliation over a rotating sample (Sunday).
0 6 * * 0      set -a; . /etc/fafnir/fafnir.env; set +a; cd $FAFNIR_HOME && scripts/reconcile.sh AAPL,MSFT,SPY,BRK-B >> var/fafnir/log/cron_reconcile.log 2>&1
