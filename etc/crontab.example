# fafnir cron schedule (example). Install with: crontab etc/crontab.example
# Adjust paths and times to your host and market timezone. Secrets should be
# sourced from a protected env file rather than inlined here.
#
# Times are server-local. US EOD data is typically settled a few hours after the
# 16:00 ET close; 22:30 ET (here shown as a generic evening slot) is a safe slot.

# Load environment (DSN + API key) from a root-only file. Values must be quoted --
# the recipes below source this file with `set -a; . file`.
# Example fafnir.env contents:
#   FAFNIR_DSN="host=localhost dbname=fafnir user=fafnir_ingest"
#   PGPASSWORD="..."                 # NOT FAFNIR_DB_PASSWORD: that is ignored when
#                                    # FAFNIR_DSN is set (see etc/fafnirrc).
#   FMP_API_KEY="..."
#   FAFNIR_SQL_DIR="/opt/fafnir/sql"
#   PATH="/opt/fafnir/.venv/bin:/usr/local/bin:/usr/bin:/bin"   # if installed in a venv

SHELL=/bin/bash
FAFNIR_HOME=/opt/fafnir

# Daily incremental update (Mon-Fri evening, after settlement).
30 22 * * 1-5  set -a; . /etc/fafnir/fafnir.env; set +a; cd $FAFNIR_HOME && scripts/daily_update.sh >> var/fafnir/log/cron_daily.log 2>&1

# Mid-evening data-quality sweep.
0 23 * * 1-5   set -a; . /etc/fafnir/fafnir.env; set +a; cd $FAFNIR_HOME && scripts/run_dq_checks.sh >> var/fafnir/log/cron_dq.log 2>&1

# Weekly reconciliation over a rotating sample (Sunday).
0 6 * * 0      set -a; . /etc/fafnir/fafnir.env; set +a; cd $FAFNIR_HOME && scripts/reconcile.sh AAPL,MSFT,SPY,BRK-B >> var/fafnir/log/cron_reconcile.log 2>&1

# --- Backups (see doc/adr/0007-offsite-backup-storage.md) --------------------
# The off-site jobs need FAFNIR_BACKUP_REPO and RESTIC_PASSWORD_FILE in
# /etc/fafnir/fafnir.env, e.g.:
#   FAFNIR_BACKUP_REPO="rclone:dropbox-fafnir:"    # or b2:... / sftp:...
#   RESTIC_PASSWORD_FILE="/etc/fafnir/restic.pass"

# Daily state snapshot: ref + ops + meta only -- the declared universe, the DQ
# resolutions and the migration ledger. Seconds to run, and the only copy of
# decisions a human made; a weekly cycle is too coarse for these alone.
15 23 * * 1-5  set -a; . /etc/fafnir/fafnir.env; set +a; cd $FAFNIR_HOME && scripts/backup_offsite.sh --state-only >> var/fafnir/log/cron_backup.log 2>&1

# Weekly full warehouse (Sunday, after the reconciliation run above).
30 6 * * 0     set -a; . /etc/fafnir/fafnir.env; set +a; cd $FAFNIR_HOME && scripts/backup_offsite.sh >> var/fafnir/log/cron_backup.log 2>&1

# Monthly prune + verification. Kept off the weekly schedule deliberately: prune
# rewrites pack files and lists the whole repository, which is the step that trips
# Dropbox's rate limiter, and it is the only step that reads data back.
0 8 1 * *      set -a; . /etc/fafnir/fafnir.env; set +a; cd $FAFNIR_HOME && scripts/backup_offsite.sh --prune >> var/fafnir/log/cron_backup.log 2>&1
