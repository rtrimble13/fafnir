[Unit]
Description=fafnir daily incremental update
Documentation=file://@FAFNIR_HOME@/doc/install_hetzner.md
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=@FAFNIR_USER@
Group=@FAFNIR_GROUP@
WorkingDirectory=@FAFNIR_HOME@
EnvironmentFile=@ENV_FILE@
# The CLI writes its own rotating fafnir.log via log_dir, whose default is
# RELATIVE -- so with WorkingDirectory above it would land in
# @FAFNIR_HOME@/var/fafnir/log, inside the deployed git checkout, where
# logrotate and monitor.sh never look. Pin it to the unit's own log dir.
Environment=FAFNIR_LOG_DIR=@LOG_DIR@
ExecStart=@FAFNIR_HOME@/scripts/daily_update.sh
StandardOutput=append:@LOG_DIR@/daily.log
StandardError=append:@LOG_DIR@/daily.log
# A first run against a universe that has never been backfilled can take hours.
# The default 90s would kill it mid-load.
TimeoutStartSec=6h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
