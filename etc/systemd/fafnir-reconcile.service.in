[Unit]
Description=fafnir weekly reconciliation against the live feed
Documentation=file://@FAFNIR_HOME@/doc/operations.md
After=postgresql.service network-online.target
Wants=postgresql.service network-online.target

[Service]
Type=oneshot
User=@FAFNIR_USER@
Group=@FAFNIR_GROUP@
WorkingDirectory=@FAFNIR_HOME@
EnvironmentFile=@ENV_FILE@
# The CLI writes its own rotating fafnir.log via log_dir, whose default is
# RELATIVE -- so with WorkingDirectory above it would land in
# @FAFNIR_HOME@/var/fafnir/log, inside the deployed git checkout, where
# logrotate and monitor.sh never look. Pin it to the unit's own log dir.
Environment=FAFNIR_LOG_DIR=@LOG_DIR@
ExecStart=@FAFNIR_HOME@/scripts/reconcile.sh @RECONCILE_SYMBOLS@
StandardOutput=append:@LOG_DIR@/reconcile.log
StandardError=append:@LOG_DIR@/reconcile.log
TimeoutStartSec=1h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
