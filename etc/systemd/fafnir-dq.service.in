[Unit]
Description=fafnir data-quality sweep
Documentation=file://@FAFNIR_HOME@/doc/operations.md
After=postgresql.service fafnir-daily.service
Wants=postgresql.service

[Service]
Type=oneshot
User=@FAFNIR_USER@
Group=@FAFNIR_GROUP@
WorkingDirectory=@FAFNIR_HOME@
EnvironmentFile=@ENV_FILE@
# The CLI writes its own rotating fafnir.log via log_dir, whose default is
# RELATIVE -- so with WorkingDirectory above it would land in
# @FAFNIR_HOME@/var/fafnir/log, inside the deployed git checkout, where
# logrotate and monitor.sh never look. Pin it to the unit's own log dir.
Environment=FAFNIR_LOG_DIR=@LOG_DIR@
ExecStart=@FAFNIR_HOME@/scripts/run_dq_checks.sh @DQ_EXCHANGE@
StandardOutput=append:@LOG_DIR@/dq.log
StandardError=append:@LOG_DIR@/dq.log
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
