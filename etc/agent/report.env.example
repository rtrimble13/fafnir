# /etc/fafnir/report.env -- read by fafnir-report.service as root, before it
# drops to the agent user. See doc/nightly_report.md.
#
# No secret belongs here: this file only names addresses, and 644 is correct for
# it. The SMTP credential lives in the agent's ~/.msmtprc, which is the one file
# that has to be 600.
#
#   sudo install -m 644 etc/agent/report.env.example /etc/fafnir/report.env

FAFNIR_REPORT_TO=you@example.com
FAFNIR_REPORT_FROM=fafnir-db <you@example.com>

# The agent's own read-only role (doc/agent.md step 5), peer-authenticated over
# the local socket -- a name, not a credential, which is why it belongs in a 644
# file. monitor.sh's `runs` and `bandwidth` checks query Postgres; its usual
# fallback is to source /etc/fafnir/fafnir.env, which is root:fafnir 0640 and
# denied to the agent by design. Without this line those two checks skip
# themselves and the night still summarises as clean.
#
# Never fafnir_ingest: that is the write identity (doc/agent.md).
FAFNIR_DSN=dbname=fafnir user=claude_ops

# Optional overrides:
#FAFNIR_REPORT_WINDOW=18 hours ago
#FAFNIR_REPORT_STATE_DIR=/home/claude/fafnir-report
